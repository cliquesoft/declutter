#!/bin/sh
# declutter	a script to declutter user-generated data via:
#			archive data
#			clean mismatched
#			deduplicate data
#			erase empty dirs
#
# created	2026/05/04 by Dave Henderson (support@cliquesoft.org)
# updated	2026/05/20 by Dave Henderson (support@cliquesoft.org)
